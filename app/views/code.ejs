<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Editor</title>
        <link href='https://fonts.googleapis.com/css?family=JetBrains Mono' rel='stylesheet'>
        <link rel="stylesheet" href="/css/code.css">
    </head>
    <body>
        <%- include('partials/header') %>
        <div id="header-gap"></div>
        <div id="workspace-container">
            <div id="code-editor-container">
                <div id="code-editor">
                    <div id="number-column">1<br>2<br>3<br>4<br>5<br>6<br>7<br>8<br>9<br>10<br>11<br>12<br>13<br>14</div>
                    <div id="code-input-container">
                        <textarea id="code-input">
a = (5 + 5) * 10;
b = print("The value of a + 5 is...");
print(a + 5);
print("The return value of b is", b);
                        </textarea>
                    </div>
                </div>

                <div id="code-editor-footer">
                    <div id="file-settings">
                        <button class="file-setting">IMPORT</button>
                        <button class="file-setting">EXPORT</button>
                    </div>
                    <div id="submit-button-container">
                        <button id="submit-button">Submit Code</button>
                    </div>
                </div>
            </div>

            <div id="info">
                <div id="tabs">
                    <button class="tab" onclick="changeTab('Output')" id="selected">Output</button>
                    <button class="tab" onclick="changeTab('Variables')">Variables</button>
                    <button class="tab" onclick="changeTab('Tokens')">Tokens</button>
                    <button class="tab" onclick="changeTab('AST')">AST</button>
                    <button class="tab" onclick="changeTab('Docs')">Docs</button>
                    <button class="tab" onclick="changeTab('Logs')">Logs</button>
                </div>
                <div class="output" id="output-output">Run code to get an output</div>
                <div class="output" id="variables-output" hidden="true">Run code to see the variables</div>
                <div class="output" id="tokens-output" hidden="true">Run code to see the tokens</div>
                <div class="output" id="ast-output" hidden="true">Run code to see the abstract syntax tree</div>
                <div class="output" id="docs-output" hidden="true">Docs</div>
                <div class="output" id="logs-output" hidden="true">
                    <% updateLog.forEach(log => { %>
                        <div class="update-log">
                            <div class="log-bar"></div>
                            <div>
                                <div class="log-version"><%= log.version%></div>
                                <div class="log-date"><%= log.date%></div>
                                <ul class="log-container">
                                    <% log.additions.forEach(addition => { %>
                                        <li class="log-addition"><%= addition%></li>
                                    <% }) %>
                                    <% log.changes.forEach(change => { %>
                                        <li class="log-change"><%= change%></li>
                                    <% }) %>
                                    <% log.removals.forEach(removal => { %>
                                        <li class="log-removal"><%= removal%></li>
                                    <% }) %> 
                                    </ul>                      
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
        <script src="/js/code.js"></script>
    </body>
</html>