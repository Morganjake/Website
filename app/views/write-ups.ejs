<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Write-ups</title>
        <link href='https://fonts.googleapis.com/css?family=JetBrains Mono' rel='stylesheet'>
        <link rel="stylesheet" href="/css/write-ups.css">
    </head>
    <body>
        <%- include('partials/header') %>
        <div id="page-container">
            <div id="sidebar">
                <% algorithms.forEach(topic => { %>
                    <div class="topic-list">
                        <button class="topic-name"><%= topic.topicName%></button>
                        <ul class="algorithm-list">
                            <% topic.algorithms.forEach(algorithm => { %>
                                <li>
                                    <button class="algorithm" onclick="changeWriteup('<%= topic.topicName %>', '<%= algorithm %>')" ><%= algorithm %></button>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                <% }) %>
            </div>
            <div id="writeup">
                <%- include('write-ups/' + topic + '/' + algorithm) %>
            </div>
        </div>
        <script src="/js/write-ups.js"></script>
    </body>
</html>